process {
    withName: SRATOOLS_FASTERQDUMP {
        // Upstream default, deliberately unchanged here: `--split-3` is opted into by
        // the CALLER's config, because it is only correct for a pipeline that wants
        // properly-paired mates. 10x-style fetches rely on `--split-files
        // --include-technical` keeping every read segment, including technical ones.
        ext.args = '--split-files --include-technical'
        // ONE rule, and deliberately the upstream one. `--split-3`'s orphans are
        // renamed <prefix>_unpaired.fastq.gz by main.nf and stay in the task root, so
        // this pattern already covers them: they land beside _1/_2 in
        // <outdir>/fastq/, registered rather than discarded. The second entry this
        // replaces carried `pattern: "unpaired/*.fastq.gz"`, and against a `gs://`
        // outdir under `scratch = true` + `stageOutMode = 'copy'` it published
        // nothing — the orphans died with the work dir when the fetch succeeded.
        publishDir = [
            path: { "${params.outdir}/fastq" },
            mode: params.publish_dir_mode,
            pattern: "*.fastq.gz"
        ]
    }
}
