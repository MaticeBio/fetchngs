process {
    withName: SRATOOLS_FASTERQDUMP {
        // Upstream default, deliberately unchanged here: `--split-3` is opted into by
        // the CALLER's config, because it is only correct for a pipeline that wants
        // properly-paired mates. 10x-style fetches rely on `--split-files
        // --include-technical` keeping every read segment, including technical ones.
        ext.args = '--split-files --include-technical'
        publishDir = [
            [
                path: { "${params.outdir}/fastq" },
                mode: params.publish_dir_mode,
                pattern: "*.fastq.gz"
            ],
            [
                // `unpaired/` only exists under `--split-3`. Published (not discarded)
                // so the reads are registered rather than silently dropped — nothing
                // downstream consumes them today. The pattern keeps its directory, so
                // these land in <outdir>/fastq/unpaired/.
                path: { "${params.outdir}/fastq" },
                mode: params.publish_dir_mode,
                pattern: "unpaired/*.fastq.gz"
            ]
        ]
    }
}
