/*
 * Config for `unpaired.nf.test` — the `--split-3` orphan-segregation tests.
 *
 * Three things it has to arrange, and each one is a reason no test of this existed
 * before:
 *
 * 1. `ext.args = '--split-3'`. The module's other test config (`nextflow.config`,
 *    beside this file) sets `ext.args = ''`, so neither existing case exercises a
 *    split mode at all — the segregation path shipped uncovered.
 *
 * 2. The real module script, against FAKE `fasterq-dump` and `pigz` on PATH. An
 *    orphan file only appears for an accession with mate-less spots, and the smallest
 *    real one (SRR6001133, 6,969,288 spots) is not a test fixture. `beforeScript`
 *    copies `unpaired/fakebin/` into the task dir and prepends it to PATH, so this
 *    needs no sratools container, no network and no SRA — while still running the
 *    module's own `script:` block, which is where the segregation lives.
 *
 * 3. `scratch = true` + `stageOutMode = 'copy'`: the PRODUCTION unstaging surface
 *    (AnimateIQ `nextflow/conf/staging.config`), and the one the `unpaired/`
 *    subdirectory this replaced silently failed on.
 *
 * Deliberately NOT reproduced: a `gs://` outdir. That is the one difference between
 * this and the failing production fetch, and it is exactly why the fix is a flat
 * filename covered by the publishDir rule that already works there, rather than a
 * repair of the nested one.
 *
 * Run it with `NXF_SYNTAX_PARSER=v1`, as the platform launches every fetch
 * (`app/routers/samplesheets._FETCH_PARSER_ENV`): 1.12.0's root `nextflow.config`
 * defines `check_max()`, which Nextflow 26's strict parser rejects.
 */

// The module's own publishDir rule is under test, so its params must exist.
params.publish_dir_mode = 'copy'

// Run on the host, not in the sratools container: the fakes live on PATH.
docker.enabled       = false
podman.enabled       = false
singularity.enabled  = false
apptainer.enabled    = false
charliecloud.enabled = false
shifter.enabled      = false
conda.enabled        = false

// The real `publishDir` and the real upstream `ext.args`, then the overrides below.
includeConfig '../nextflow.config'

process {
    // The production unstaging surface — see the header.
    scratch      = true
    stageOutMode = 'copy'

    withName: SRATOOLS_FASTERQDUMP {
        // What the platform actually launches with (AnimateIQ
        // `nextflow/pipelines/fetchngs.config`), and what the module default is not.
        ext.args = '--split-3 --include-technical'

        // COPIED into the task dir and chmod'd rather than put on PATH where they
        // sit, so the test does not depend on the checkout having preserved a mode
        // bit. One line and no heredoc on purpose: Nextflow indents `beforeScript`
        // into the wrapper, which silently breaks an unindented heredoc terminator.
        // `beforeScript` runs before `cd $NXF_SCRATCH` and PATH is exported with an
        // absolute `$PWD`, so it survives the move to the scratch dir.
        beforeScript = "mkdir -p .fakebin && cp ${projectDir}/modules/nf-core/sratools/fasterqdump/tests/unpaired/fakebin/* .fakebin/ && chmod +x .fakebin/* && export PATH=\"\$PWD/.fakebin:\$PATH\""
    }
}
